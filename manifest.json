{
  "id": "scheduler",
  "version": "0.1.0",
  "runtime": "local-http",
  "entry": {
    "command": "bin/scheduler-server",
    "args": []
  },
  "api": {
    "basePath": "/api/scheduler",
    "health": {
      "method": "GET",
      "path": "/health"
    },
    "events": {
      "transport": "sse",
      "path": "/api/scheduler/events"
    }
  },
  "capabilities": [
    "task-decomposition",
    "timeline-scheduling",
    "task-storage",
    "hierarchical-task-tree",
    "custom-task-granularity",
    "rolling-wave-planning",
    "adaptive-replanning",
    "voyage-runtime"
  ],
  "events": [
    "task.created",
    "task.updated",
    "task.deleted",
    "timeline.changed",
    "schedule.plan_generated",
    "schedule.plan_confirmed",
    "schedule.granularity_requested",
    "schedule.granularity_applied",
    "schedule.granularity_suggested",
    "schedule.routine_suggested",
    "schedule.routine_applied",
    "schedule.task_completed"
  ],
  "permissions": [
    "llm-api"
  ]
}
