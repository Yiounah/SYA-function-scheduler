#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8000}"

python_can_serve() {
  "$1" -c 'import sys, uvicorn; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

select_python() {
  if [[ -n "${PYTHON:-}" ]]; then
    if python_can_serve "${PYTHON}"; then
      echo "${PYTHON}"
      return
    fi
    echo "PYTHON=${PYTHON} cannot import uvicorn on Python 3.11+." >&2
    exit 1
  fi

  for candidate in \
    "${ROOT_DIR}/.venv/bin/python" \
    "/opt/miniconda3/bin/python3.13" \
    "/opt/homebrew/bin/python3" \
    "python3.13" \
    "python3.12" \
    "python3.11" \
    "python3" \
    "python"; do
    [[ -n "${candidate}" ]] || continue
    if ([[ -x "${candidate}" ]] || command -v "${candidate}" >/dev/null 2>&1) && python_can_serve "${candidate}"; then
      echo "${candidate}"
      return
    fi
  done

  echo "No Python 3.11+ with uvicorn found for ${ROOT_DIR}." >&2
  echo "Create the module environment, then retry:" >&2
  echo "  python3.13 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt" >&2
  exit 1
}

PYTHON_BIN="$(select_python)"

if [[ -f "${ROOT_DIR}/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "${ROOT_DIR}/.env"
  set +a
fi

export PYTHONPATH="${ROOT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
cd "${ROOT_DIR}"
exec "${PYTHON_BIN}" -m uvicorn app.main:app --host "${HOST}" --port "${PORT}"
